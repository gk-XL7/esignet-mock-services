{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",

  "$defs": {
    "langField": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": ["khm", "eng"]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["language", "value"],
        "additionalProperties": false
      }
    },

    "fileObject": {
      "type": "object",
      "properties": {
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "fileSizeMB": { "type": "number", "minimum": 0 },
        "data": { "type": "string" }
      },
      "required": ["fileName", "fileType", "data"],
      "additionalProperties": false
    }
  },

  "properties": {
    "individualId": {
      "type": "string",
      "pattern": "\\S"
    },

    "phone": {
      "type": "string",
      "pattern": "^\\+[1-9]\\d{8,13}$"
    },

    "username": {
      "type": "string",
      "allOf": [
        { "pattern": "^\\d{9,10}$" },
        { "pattern": "^(?!0).*$" }
      ]
    },

    "fullName": {
      "oneOf": [
        {
          "$ref": "#/$defs/langField"
        },
        {
          "type": "object",
          "properties": {
            "khm": {
              "type": "string",
              "pattern": "^[\\u1780-\\u17FF\\u19E0-\\u19FF\\u1A00-\\u1A9F ]{1,30}$"
            },
            "eng": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z ]{1,30}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },

    "password": {
      "type": "string",
      "minLength": 8
    },

    "dob": {
      "type": "string",
      "format": "date"
    },

    "details": {
      "type": "string"
    },

    "encodedPhoto": {
      "type": "string"
    },

    "photoCapture": {
      "$ref": "#/$defs/fileObject"
    },

    "gender": {
      "type": "string",
      "enum": ["male", "female", "other"]
    },

    "passport": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["aadhar", "rental"]
        },
        "file": {
          "$ref": "#/$defs/fileObject"
        }
      },
      "required": ["type", "file"],
      "additionalProperties": false
    },

    "photo": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["selfie", "profile"]
        },
        "file": {
          "$ref": "#/$defs/fileObject"
        }
      },
      "required": ["type", "file"],
      "additionalProperties": false
    },

    "consent": {
      "type": "boolean"
    },

    "preferredLang": {
      "type": "string",
      "enum": ["khm", "eng"],
      "nullable": true
    }
  },

  "required": [
    "individualId",
    "password"
  ],

  "additionalProperties": true
}
